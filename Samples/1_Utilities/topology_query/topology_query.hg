 *
 * topology_query — Multi-PPU System Topology Report
 *
 * Produces a structured report of the PPU system topology:
 *   1. Per-device summary (name, compute units, memory, clock)
 *   2. P2P connectivity matrix (access + atomic support)
 *   3. Performance-rank grouping for optimal device pairing
 *
 * Useful for understanding multi-device configurations before
 * deciding on data placement or migration strategies.
 */
#include <cstdio>
#include <cstring>
#include <vector>

#include <hggc.h>
#include <hggc_runtime.h>
#include <helper_hggc.h>
#include <helper_functions.h>

namespace {

// ═══════════════════════════════════════════════════════════════════════
// Section 1: Per-device hardware summary
// ═══════════════════════════════════════════════════════════════════════

void print_device_summary(int device_count)
{
    printf("\n");
    printf("+-----+------------------------+------+----------+-----------+\n");
    printf("| PPU | Name                   |  CUs | Mem (MB) | Clock MHz |\n");
    printf("+-----+------------------------+------+----------+-----------+\n");

    for (int i = 0; i < device_count; ++i) {
        hggcDeviceProp props;
        checkHggcErrors(hggcGetDeviceProperties(&props, i));

        int clock_mhz = 0;
#if HGGC_VERSION >= 13000
        hggcDeviceGetAttribute(&clock_mhz, hggcDevAttrClockRate, i);
        clock_mhz /= 1000;  // kHz -> MHz
#else
        clock_mhz = props.clockRate / 1000;  // kHz -> MHz
#endif

        const int mem_mb = static_cast<int>(props.totalGlobalMem / (1024 * 1024));

        printf("| %3d | %-22.22s | %4d | %8d | %9d |\n",
               i, props.name, props.multiProcessorCount, mem_mb, clock_mhz);
    }
    printf("+-----+------------------------+------+----------+-----------+\n");
}

// ═══════════════════════════════════════════════════════════════════════
// Section 2: P2P connectivity matrix
// ═══════════════════════════════════════════════════════════════════════

struct P2PLink {
    int src;
    int dst;
    int access;    // 1 = can access peer memory
    int atomic;    // 1 = native atomic supported
    int perf_rank; // higher = better interconnect
};

void print_p2p_matrix(int device_count, const std::vector<P2PLink> &links)
{
    // Build access matrix for compact display.
    // Legend: '.' = no access, 'A' = access only, '*' = access + atomic
    printf("\n  P2P Access Matrix (row->col):  '.' no access  'A' access  '*' access+atomic\n\n");
    printf("      ");
    for (int j = 0; j < device_count; ++j) printf(" P%d", j);
    printf("\n");

    for (int i = 0; i < device_count; ++i) {
        printf("  P%d  ", i);
        for (int j = 0; j < device_count; ++j) {
            if (i == j) {
                printf("  -");
                continue;
            }
            // Find link i->j
            char sym = '.';
            for (const auto &lk : links) {
                if (lk.src == i && lk.dst == j) {
                    sym = lk.atomic ? '*' : (lk.access ? 'A' : '.');
                    break;
                }
            }
            printf("  %c", sym);
        }
        printf("\n");
    }
}

// ═══════════════════════════════════════════════════════════════════════
// Section 3: Performance-rank grouping
// ═══════════════════════════════════════════════════════════════════════

void print_perf_groups(const std::vector<P2PLink> &links)
{
    // Find the maximum perf rank across all links.
    int max_rank = 0;
    for (const auto &lk : links) {
        if (lk.access && lk.perf_rank > max_rank)
            max_rank = lk.perf_rank;
    }

    if (max_rank == 0) {
        printf("\n  No P2P links with performance rank > 0 detected.\n");
        return;
    }

    printf("\n  Performance Groups (higher rank = faster interconnect):\n");
    for (int rank = max_rank; rank >= 1; --rank) {
        bool header_printed = false;
        for (const auto &lk : links) {
            if (lk.access && lk.perf_rank == rank) {
                if (!header_printed) {
                    printf("\n    Rank %d:\n", rank);
                    header_printed = true;
                }
                printf("      P%d -> P%d  (atomic: %s)\n",
                       lk.src, lk.dst, lk.atomic ? "yes" : "no");
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════
// Section 4: Host <-> Device attributes
// ═══════════════════════════════════════════════════════════════════════

void print_host_links(int device_count)
{
    printf("\n  Host <-> Device:\n");
    for (int i = 0; i < device_count; ++i) {
        int host_atomic = 0;
        hggcDeviceGetAttribute(&host_atomic, hggcDevAttrHostNativeAtomicSupported, i);

        int unified_addr = 0;
        hggcDeviceGetAttribute(&unified_addr, hggcDevAttrUnifiedAddressing, i);

        int managed_mem = 0;
        hggcDeviceGetAttribute(&managed_mem, hggcDevAttrManagedMemory, i);

        printf("    P%d: host-atomic=%s  UVA=%s  managed-mem=%s\n",
               i,
               host_atomic ? "yes" : "no",
               unified_addr ? "yes" : "no",
               managed_mem ? "yes" : "no");
    }
}

}  // namespace

int main(int argc, char **argv)
{
    printf("[topology_query] Multi-PPU System Topology Report\n");
    printf("=================================================\n");

    int device_count = 0;
    checkHggcErrors(hggcGetDeviceCount(&device_count));

    if (device_count == 0) {
        printf("No PPU devices found.\n");
        return EXIT_FAILURE;
    }
    printf("\n  Detected %d PPU device(s)\n", device_count);

    // -- Section 1: Device summary --
    print_device_summary(device_count);

    // -- Section 2 & 3: P2P links --
    std::vector<P2PLink> links;
    for (int src = 0; src < device_count; ++src) {
        for (int dst = 0; dst < device_count; ++dst) {
            if (src == dst) continue;

            P2PLink lk = {src, dst, 0, 0, 0};
            hggcDeviceGetP2PAttribute(&lk.access, hggcDevP2PAttrAccessSupported, src, dst);
            if (lk.access) {
                hggcDeviceGetP2PAttribute(&lk.perf_rank, hggcDevP2PAttrPerformanceRank, src, dst);
                hggcDeviceGetP2PAttribute(&lk.atomic, hggcDevP2PAttrNativeAtomicSupported, src, dst);
            }
            links.push_back(lk);
        }
    }

    print_p2p_matrix(device_count, links);
    print_perf_groups(links);

    // -- Section 4: Host links --
    print_host_links(device_count);

    printf("\n  Report complete.\n");
    return EXIT_SUCCESS;
}
