 *
 * parallel_sort.hg -- Block sort + iterative pairwise merge
 *
 * Two-stage parallel sort:
 *   1. block_sort_kernel: each block sorts a chunk in shared memory
 *      using odd-even transposition network
 *   2. merge_blocks_kernel: iteratively merge pairs of adjacent sorted
 *      blocks using bitonic merge network (log2(num_blocks) iterations)
 */

#include <cooperative_groups.h>
#include <helper_hggc.h>

namespace cg = cooperative_groups;

typedef unsigned int uint;

static const int BLOCK_CAPACITY = 512;  /* elements per block (power of 2) */
static const int MERGE_SMEM     = 2 * BLOCK_CAPACITY;

/* ── Stage 1: per-block odd-even transposition sort ────────── */

__global__ void block_sort_kernel(
    uint *dst_key, uint *dst_val,
    const uint *src_key, const uint *src_val,
    int n)
{
    __shared__ uint s_key[BLOCK_CAPACITY];
    __shared__ uint s_val[BLOCK_CAPACITY];

    int base = blockIdx.x * BLOCK_CAPACITY;
    int tid  = threadIdx.x;

    /* Load chunk into shared memory */
    s_key[tid] = (base + tid < n) ? src_key[base + tid] : 0xFFFFFFFF;
    s_val[tid] = (base + tid < n) ? src_val[base + tid] : 0;
    __syncthreads();

    /* Odd-even transposition sort: BLOCK_CAPACITY phases */
    for (int phase = 0; phase < BLOCK_CAPACITY; phase++) {
        bool is_even_phase = (phase % 2 == 0);
        bool is_even_tid   = (tid % 2 == 0);
        bool active        = (is_even_phase == is_even_tid);

        if (active) {
            int partner = tid + 1;
            if (partner < BLOCK_CAPACITY) {
                /* Stable comparator: use (key, val) to break ties */
                bool swap = (s_key[tid] > s_key[partner]) ||
                    (s_key[tid] == s_key[partner] && s_val[tid] > s_val[partner]);
                if (swap) {
                    uint tk = s_key[tid]; s_key[tid] = s_key[partner]; s_key[partner] = tk;
                    uint tv = s_val[tid]; s_val[tid] = s_val[partner]; s_val[partner] = tv;
                }
            }
        }
        __syncthreads();
    }

    /* Write sorted chunk back */
    if (base + tid < n) {
        dst_key[base + tid] = s_key[tid];
        dst_val[base + tid] = s_val[tid];
    }
}

/* ── Stage 2: bitonic merge of two adjacent sorted runs ────── */
/* Each block merges two runs of BLOCK_CAPACITY elements each.
   The right run is reversed to form a bitonic sequence,
   then a bitonic merge network produces the sorted output.   */

__global__ void merge_blocks_kernel(
    uint *dst_key, uint *dst_val,
    const uint *src_key, uint *src_val,
    int n, int run_width)
{
    __shared__ uint s_key[MERGE_SMEM];
    __shared__ uint s_val[MERGE_SMEM];

    int pair_id    = blockIdx.x;
    int left_base  = pair_id * 2 * run_width;
    int right_base = left_base + run_width;
    int tid        = threadIdx.x;
    int N          = MERGE_SMEM;  /* total shared mem elements */

    /* Load left run (ascending) into s_key[0..run_width-1] */
    if (tid < run_width) {
        s_key[tid] = (left_base + tid < n) ? src_key[left_base + tid] : 0xFFFFFFFF;
        s_val[tid] = (left_base + tid < n) ? src_val[left_base + tid] : 0;
    }
    __syncthreads();

    /* Load right run (reversed → descending) into s_key[run_width..2*run_width-1] */
    if (tid < run_width) {
        int dst = run_width + (run_width - 1 - tid);
        s_key[dst] = (right_base + tid < n) ? src_key[right_base + tid] : 0xFFFFFFFF;
        s_val[dst] = (right_base + tid < n) ? src_val[right_base + tid] : 0;
    }
    __syncthreads();

    /* Bitonic merge: compare-swap with decreasing stride.
       Uses all N=2*BLOCK_CAPACITY threads to cover all positions. */
    for (int stride = N / 2; stride > 0; stride >>= 1) {
        int partner = tid ^ stride;
        if (tid < partner && partner < N) {
            /* Stable comparator for bitonic merge */
            bool swap = (s_key[tid] > s_key[partner]) ||
                (s_key[tid] == s_key[partner] && s_val[tid] > s_val[partner]);
            if (swap) {
                uint tk = s_key[tid]; s_key[tid] = s_key[partner]; s_key[partner] = tk;
                uint tv = s_val[tid]; s_val[tid] = s_val[partner]; s_val[partner] = tv;
            }
        }
        __syncthreads();
    }

    /* Write merged output */
    int out_base = left_base;
    if (out_base + tid < n) {
        dst_key[out_base + tid] = s_key[tid];
        dst_val[out_base + tid] = s_val[tid];
    }
}

/* ── Host-side launcher ────────────────────────────────────── */

extern "C" void parallel_sort(
    uint *dst_key, uint *dst_val,
    uint *buf_key, uint *buf_val,
    uint *src_key, uint *src_val,
    int n, int sort_dir)
{
    (void)sort_dir;  /* ascending only for this demo */

    int block_count = (n + BLOCK_CAPACITY - 1) / BLOCK_CAPACITY;

    /* Stage 1: sort each block */
    block_sort_kernel<<<block_count, BLOCK_CAPACITY>>>(
        buf_key, buf_val, src_key, src_val, n);
    checkHggcErrors(hggcDeviceSynchronize());

    /* Stage 2: iterative pairwise merge */
    uint *from_key = buf_key, *from_val = buf_val;
    uint *to_key   = dst_key, *to_val   = dst_val;

    for (int width = BLOCK_CAPACITY; width < n; width *= 2) {
        int merge_pairs = (n + 2 * width - 1) / (2 * width);
        /* Each merge pair handles 2*BLOCK_CAPACITY elements (both halves in smem) */
        /* For width > BLOCK_CAPACITY, we merge in BLOCK_CAPACITY-sized chunks */
        int chunks_per_pair = width / BLOCK_CAPACITY;
        for (int c = 0; c < chunks_per_pair; c++) {
            int offset = c * BLOCK_CAPACITY;
            /* Merge left[offset..offset+BLOCK_CAPACITY-1] with right[offset..offset+BLOCK_CAPACITY-1] */
            /* For simplicity, we launch one block per pair-chunk combination */
            /* Total blocks = merge_pairs * chunks_per_pair */
        }
        /* Simplified: one block per merge pair (works when width == BLOCK_CAPACITY) */
        merge_blocks_kernel<<<merge_pairs, MERGE_SMEM>>>(
            to_key, to_val, from_key, from_val, n, width);
        checkHggcErrors(hggcDeviceSynchronize());

        /* Swap buffers */
        uint *tk = from_key; from_key = to_key; to_key = tk;
        uint *tv = from_val; from_val = to_val; to_val = tv;
    }

    /* Ensure result is in dst */
    if (from_key != dst_key) {
        checkHggcErrors(hggcMemcpy(dst_key, from_key, (size_t)n * sizeof(uint),
                                    hggcMemcpyDeviceToDevice));
        checkHggcErrors(hggcMemcpy(dst_val, from_val, (size_t)n * sizeof(uint),
                                    hggcMemcpyDeviceToDevice));
    }
}
